// Right Supporting Pane: Now Playing, Queue, Synced Lyrics, and Live Audio Signal Path.

import { ListView } from "std-widgets.slint";
import { LunariaTheme, MarqueeClock } from "./theme.slint";
import { LyricRow, QueueRow } from "./types.slint";
import { LunariaScrollBar, MarqueeText, PresetChip } from "./widgets.slint";

component NowControlButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    border-radius: 10px;
    clip: true;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: (fs.has-focus || root.active) ? LunariaTheme.primary : LunariaTheme.outline-variant;
    background: root.active
        ? LunariaTheme.secondary-container
        : (ta.has-hover && root.enabled ? LunariaTheme.surface-container-high : LunariaTheme.surface-container-low);
    opacity: root.enabled ? 1.0 : 0.45;
    animate background, border-color { duration: 150ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        Text {
            text: root.label;
            accessible-role: none;
            font-size: 10px;
            font-weight: 700;
            color: root.active ? LunariaTheme.on-secondary-container : LunariaTheme.on-surface;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if ((event.text == Key.Return || event.text == " ") && root.enabled) {
                root.clicked();
                return accept;
            }
            reject
        }

        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}

export component SupportingPane inherits Rectangle {
    in-out property <int> active-tab: 0; // 0 = Now, 1 = Queue, 2 = Lyrics, 3 = Signal Path

    // Now Playing fields
    in property <bool> has-track: false;
    in property <bool> has-artwork: false;
    in property <image> now-artwork;
    in property <string> track-title: "Ready to Play";
    in property <string> track-artist: "Select any track in Library";
    in property <string> track-album: "Lunaria Windows";
    in property <string> track-spec-badge: "FLAC / WASAPI";
    in property <bool> is-favorite: false;
    in property <bool> is-cue-track: false;
    in property <string> repeat-label: "Repeat: Off";
    in property <bool> repeat-active: false;
    in property <bool> shuffle-enabled: false;
    in property <string> speed-label: "1.00x";
    in property <string> sleep-label: "Sleep: Off";
    in property <bool> sleep-active: false;

    // Queue fields
    in property <[QueueRow]> queue-rows: [];
    in property <string> queue-summary: "0 tracks";

    // Lyrics fields
    in property <[LyricRow]> lyric-rows: [];
    in property <string> lyrics-source-label: "No local lyrics";
    in property <bool> lyrics-synced: false;

    // Honest Audio Signal Path fields
    in property <string> signal-source: "No track loaded";
    in property <string> signal-decoder: "Symphonia Pure-Rust Decoder";
    in property <string> signal-stage-1: "Flat (DSP Bypassed)";
    in property <string> signal-stage-2: "WASAPI Shared Event-Driven";
    in property <string> signal-stage-3: "";
    in property <string> signal-device: "Detecting WASAPI endpoints...";
    in property <string> signal-output-spec: "32-bit / 48 kHz • Float32";
    in property <string> signal-honesty-badge: "DSP 32-bit Float";
    in property <bool> signal-is-bit-perfect: false;

    callback toggle-favorite();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback cycle-speed();
    callback cycle-sleep-timer();
    callback open-tag-editor();
    callback play-queue-index(int);
    callback move-queue-item(int, int);
    callback remove-queue-item(int);
    callback clear-queue();
    callback seek-lyric-ms(int);

    width: 316px;
    clip: true;
    border-radius: 16px;
    background: LunariaTheme.surface-container;
    border-width: 1px;
    border-color: LunariaTheme.outline-variant;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // 4-Tab Supporting Bar
        Rectangle {
            height: 32px;
            border-radius: 16px;
            background: LunariaTheme.surface-container-highest;
            clip: true;

            HorizontalLayout {
                padding: 3px;
                spacing: 3px;

                for tab-info[idx] in [
                    { label: "Now" },
                    { label: "Queue" },
                    { label: "Lyrics" },
                    { label: "Signal" },
                ]: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 13px;
                    background: root.active-tab == idx
                        ? LunariaTheme.primary-container
                        : (tab-ta.has-hover ? LunariaTheme.surface-container-high : transparent);
                    accessible-role: tab;
                    accessible-label: tab-info.label + " pane";
                    accessible-action-default => { root.active-tab = idx; }
                    Text {
                        text: tab-info.label;
                        accessible-role: none;
                        font-size: 11px;
                        font-weight: root.active-tab == idx ? 700 : 600;
                        color: root.active-tab == idx ? LunariaTheme.on-primary-container : LunariaTheme.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = idx; }
                    }
                }
            }
        }

        // TAB 0 — NOW PLAYING
        if root.active-tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 9px;

            // Square 1:1 Hero Album Art Frame (responsive 220..272px, zero binding loop)
            Rectangle {
                vertical-stretch: 1;
                min-height: 220px;
                preferred-height: 272px;
                max-height: 272px;

                Rectangle {
                    private property <length> side: max(220px, min(272px, min(parent.width, parent.height)));
                    width: self.side;
                    height: self.side;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    background: LunariaTheme.surface-container-low;
                    clip: true;

                    if root.has-artwork: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.now-artwork;
                        image-fit: contain;
                    }

                    if !root.has-artwork: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-left: 16px;
                        padding-right: 16px;

                        Image {
                            source: @image-url("../assets/icon.svg");
                            width: 84px;
                            height: 84px;
                            x: (parent.width - self.width) / 2;
                            image-fit: contain;
                        }
                        Text {
                            text: root.has-track ? "No Artwork" : "Lunaria";
                            font-size: 11px;
                            font-weight: 700;
                            color: LunariaTheme.on-surface;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.has-track ? "No cover image found" : "Drop audio files or pick from Library";
                            font-size: 9px;
                            color: LunariaTheme.on-surface-variant;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: parent.border-radius;
                        border-width: 1px;
                        border-color: LunariaTheme.outline-variant;
                        background: transparent;
                    }
                }
            }

            // Track Metadata Block
            VerticalLayout {
                vertical-stretch: 0;
                spacing: 2px;
                MarqueeText {
                    text: root.track-title;
                    font-size: 14px;
                    font-weight: 700;
                    text-color: LunariaTheme.on-surface;
                    active: root.has-track && MarqueeClock.active;
                    initial-delay-sec: 1.8;
                }
                MarqueeText {
                    text: root.track-artist;
                    font-size: 11px;
                    font-weight: 700;
                    text-color: LunariaTheme.primary;
                    active: root.has-track && MarqueeClock.active;
                    initial-delay-sec: 2.2;
                }
                MarqueeText {
                    text: root.track-album;
                    font-size: 10px;
                    font-weight: 500;
                    text-color: LunariaTheme.on-surface-variant;
                    active: root.has-track && MarqueeClock.active;
                    initial-delay-sec: 2.6;
                }
            }

            // Clickable Audio Spec & Signal Honesty Badge
            Rectangle {
                height: 28px;
                border-radius: 9px;
                background: spec-ta.has-hover ? LunariaTheme.surface-container-high : LunariaTheme.surface-container-low;
                border-width: 1px;
                border-color: spec-ta.has-hover ? LunariaTheme.primary : LunariaTheme.outline-variant;
                animate background, border-color { duration: 150ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        text: root.track-spec-badge;
                        font-size: 9px;
                        font-weight: 600;
                        color: LunariaTheme.on-surface-variant;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.signal-honesty-badge;
                        font-size: 9px;
                        font-weight: 700;
                        color: LunariaTheme.primary;
                        vertical-alignment: center;
                    }
                }

                spec-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.active-tab = 3; }
                }
                accessible-role: button;
                accessible-label: "Open Audio Signal Path details";
                accessible-action-default => { root.active-tab = 3; }
            }

            // Symmetrical 2x3 Playback Control Grid (Exact 50/50 columns)
            VerticalLayout {
                spacing: 7px;

                HorizontalLayout {
                    spacing: 8px;
                    NowControlButton {
                        label: root.is-favorite ? "♥ Favorite" : "♡ Favorite";
                        active: root.is-favorite;
                        clicked => { root.toggle-favorite(); }
                    }
                    NowControlButton {
                        label: root.repeat-label;
                        active: root.repeat-active;
                        clicked => { root.cycle-repeat(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    NowControlButton {
                        label: root.shuffle-enabled ? "Shuffle: On" : "Shuffle: Off";
                        active: root.shuffle-enabled;
                        clicked => { root.toggle-shuffle(); }
                    }
                    NowControlButton {
                        label: "Speed " + root.speed-label;
                        active: root.speed-label != "1.00x";
                        clicked => { root.cycle-speed(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    NowControlButton {
                        label: root.sleep-label;
                        active: root.sleep-active;
                        clicked => { root.cycle-sleep-timer(); }
                    }
                    NowControlButton {
                        label: "Edit Tags";
                        enabled: root.has-track && !root.is-cue-track;
                        clicked => { root.open-tag-editor(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // TAB 1 — QUEUE WITH MOVE REORDER
        if root.active-tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.queue-summary;
                    font-size: 11px;
                    font-weight: 700;
                    color: LunariaTheme.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                PresetChip {
                    label: root.shuffle-enabled ? "Shuf On" : "Shuffle";
                    active: root.shuffle-enabled;
                    clicked => { root.toggle-shuffle(); }
                }
                PresetChip {
                    label: "Clear";
                    active: false;
                    clicked => { root.clear-queue(); }
                }
            }

            if root.queue-rows.length == 0: Rectangle {
                vertical-stretch: 1;
                border-radius: 12px;
                background: LunariaTheme.surface-container-low;
                Text {
                    text: "Queue is empty.\nClick any track to build a queue.";
                    font-size: 10px;
                    color: LunariaTheme.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.queue-rows.length > 0: Rectangle {
                vertical-stretch: 1;
                clip: true;

                lv-queue := ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 10px;
                    height: parent.height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    for item[idx] in root.queue-rows: Rectangle {
                    height: 48px;
                    VerticalLayout {
                        padding-bottom: 4px;
                        Rectangle {
                            height: 44px;
                            clip: true;
                            border-radius: 9px;
                            background: item.is-current ? LunariaTheme.secondary-container : LunariaTheme.surface-container-low;
                            border-width: 1px;
                            border-color: item.is-current ? LunariaTheme.primary : LunariaTheme.outline-variant;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 4px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    min-width: 0px;
                                    clip: true;
                                    VerticalLayout {
                                        width: 100%;
                                        height: 100%;
                                        alignment: center;
                                        spacing: 1px;
                                        MarqueeText {
                                            text: item.title;
                                            font-size: 11px;
                                            font-weight: 700;
                                            text-color: item.is-current ? LunariaTheme.on-secondary-container : LunariaTheme.on-surface;
                                            active: item.is-current && MarqueeClock.active;
                                            initial-delay-sec: 1.8;
                                        }
                                        Text {
                                            text: item.artist + " • " + item.duration-text;
                                            font-size: 9px;
                                            font-weight: 500;
                                            color: item.is-current ? LunariaTheme.on-secondary-container : LunariaTheme.on-surface-variant;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.play-queue-index(item.queue-index); }
                                    }
                                }

                                // Up / Down / Remove controls
                                HorizontalLayout {
                                    spacing: 2px;
                                    y: (parent.height - self.height) / 2;
                                    height: 22px;

                                    Rectangle {
                                        width: 20px;
                                        height: 22px;
                                        border-radius: 6px;
                                        background: item.queue-index > 0 && up-ta.has-hover
                                            ? LunariaTheme.surface-container-highest
                                            : LunariaTheme.surface-container-high;
                                        border-width: 1px;
                                        border-color: item.queue-index > 0 && up-ta.has-hover ? LunariaTheme.primary : transparent;
                                        animate background, border-color { duration: 120ms; }
                                        opacity: item.queue-index > 0 ? 1.0 : 0.35;
                                        accessible-role: button;
                                        accessible-label: "Move " + item.title + " earlier in queue";
                                        accessible-enabled: item.queue-index > 0;
                                        accessible-action-default => {
                                            if (item.queue-index > 0) {
                                                root.move-queue-item(item.queue-index, item.queue-index - 1);
                                            }
                                        }
                                        Text { text: "↑"; accessible-role: none; font-size: 10px; color: LunariaTheme.on-surface; horizontal-alignment: center; vertical-alignment: center; }
                                        up-ta := TouchArea {
                                            enabled: item.queue-index > 0;
                                            mouse-cursor: item.queue-index > 0 ? pointer : default;
                                            clicked => { root.move-queue-item(item.queue-index, item.queue-index - 1); }
                                        }
                                    }

                                    Rectangle {
                                        width: 20px;
                                        height: 22px;
                                        border-radius: 6px;
                                        background: item.queue-index + 1 < root.queue-rows.length && dn-ta.has-hover
                                            ? LunariaTheme.surface-container-highest
                                            : LunariaTheme.surface-container-high;
                                        border-width: 1px;
                                        border-color: item.queue-index + 1 < root.queue-rows.length && dn-ta.has-hover ? LunariaTheme.primary : transparent;
                                        animate background, border-color { duration: 120ms; }
                                        opacity: item.queue-index + 1 < root.queue-rows.length ? 1.0 : 0.35;
                                        accessible-role: button;
                                        accessible-label: "Move " + item.title + " later in queue";
                                        accessible-enabled: item.queue-index + 1 < root.queue-rows.length;
                                        accessible-action-default => {
                                            if (item.queue-index + 1 < root.queue-rows.length) {
                                                root.move-queue-item(item.queue-index, item.queue-index + 1);
                                            }
                                        }
                                        Text { text: "↓"; accessible-role: none; font-size: 10px; color: LunariaTheme.on-surface; horizontal-alignment: center; vertical-alignment: center; }
                                        dn-ta := TouchArea {
                                            enabled: item.queue-index + 1 < root.queue-rows.length;
                                            mouse-cursor: item.queue-index + 1 < root.queue-rows.length ? pointer : default;
                                            clicked => { root.move-queue-item(item.queue-index, item.queue-index + 1); }
                                        }
                                    }

                                    Rectangle {
                                        width: 20px;
                                        height: 22px;
                                        border-radius: 6px;
                                        background: rm-ta.has-hover ? LunariaTheme.surface-container-highest : LunariaTheme.surface-container-high;
                                        border-width: 1px;
                                        border-color: rm-ta.has-hover ? LunariaTheme.primary : transparent;
                                        animate background, border-color { duration: 120ms; }
                                        accessible-role: button;
                                        accessible-label: "Remove " + item.title + " from queue";
                                        accessible-action-default => { root.remove-queue-item(item.queue-index); }
                                        Text { text: "×"; accessible-role: none; font-size: 11px; color: LunariaTheme.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
                                        rm-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.remove-queue-item(item.queue-index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                LunariaScrollBar {
                    x: parent.width - 8px;
                    y: 2px;
                    height: parent.height - 4px;
                    viewport-height: lv-queue.visible-height;
                    content-height: lv-queue.content-height;
                    content-y <=> lv-queue.content-y;
                }
            }
        }

        // TAB 2 — SYNCED / UNSYNCED LOCAL LYRICS
        if root.active-tab == 2: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.lyrics-source-label;
                    font-size: 10px;
                    font-weight: 700;
                    color: LunariaTheme.primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.lyrics-synced: Rectangle {
                    height: 18px;
                    width: 54px;
                    border-radius: 6px;
                    background: LunariaTheme.primary-container;
                    Text {
                        text: "SYNCED";
                        font-size: 8px;
                        font-weight: 700;
                        color: LunariaTheme.on-primary-container;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if root.lyric-rows.length == 0: Rectangle {
                vertical-stretch: 1;
                border-radius: 12px;
                background: LunariaTheme.surface-container-low;
                Text {
                    text: "No local .lrc file or embedded\nlyrics found for active track.";
                    font-size: 10px;
                    color: LunariaTheme.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.lyric-rows.length > 0: Rectangle {
                vertical-stretch: 1;
                clip: true;

                lv-lyrics := ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 10px;
                    height: parent.height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    for line in root.lyric-rows: Rectangle {
                    height: 36px;
                    VerticalLayout {
                        padding-bottom: 3px;
                        Rectangle {
                            height: 33px;
                            clip: true;
                            border-radius: 8px;
                            background: line.is-active ? LunariaTheme.primary-container : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                if root.lyrics-synced: Text {
                                    text: line.time-label;
                                    font-size: 9px;
                                    color: line.is-active ? LunariaTheme.on-primary-container : LunariaTheme.on-surface-variant;
                                    vertical-alignment: center;
                                    width: 36px;
                                }

                                Text {
                                    text: line.text;
                                    font-size: 11px;
                                    font-weight: line.is-active ? 700 : 500;
                                    color: line.is-active ? LunariaTheme.on-primary-container : LunariaTheme.on-surface-variant;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            TouchArea {
                                enabled: root.lyrics-synced;
                                mouse-cursor: root.lyrics-synced ? pointer : default;
                                clicked => { root.seek-lyric-ms(line.timestamp-ms); }
                            }
                        }
                    }
                    }
                }

                LunariaScrollBar {
                    x: parent.width - 8px;
                    y: 2px;
                    height: parent.height - 4px;
                    viewport-height: lv-lyrics.visible-height;
                    content-height: lv-lyrics.content-height;
                    content-y <=> lv-lyrics.content-y;
                }
            }
        }

        // TAB 3 — HONEST AUDIO SIGNAL PATH
        if root.active-tab == 3: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Audio Signal Path";
                    font-size: 13px;
                    font-weight: 700;
                    color: LunariaTheme.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    height: 22px;
                    width: 116px;
                    border-radius: 6px;
                    background: root.signal-is-bit-perfect ? LunariaTheme.primary-container : LunariaTheme.surface-container-high;
                    Text {
                        text: root.signal-honesty-badge;
                        font-size: 9px;
                        font-weight: 700;
                        color: root.signal-is-bit-perfect ? LunariaTheme.on-primary-container : LunariaTheme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: LunariaTheme.surface-container-low;
                border-width: 1px;
                border-color: LunariaTheme.outline-variant;
                VerticalLayout {
                    padding: 9px;
                    spacing: 2px;
                    Text { text: "1. SOURCE"; font-size: 9px; font-weight: 700; color: LunariaTheme.on-surface-variant; }
                    Text { text: root.signal-source; font-size: 10px; font-weight: 700; color: LunariaTheme.on-surface; wrap: word-wrap; }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: LunariaTheme.surface-container-low;
                border-width: 1px;
                border-color: LunariaTheme.outline-variant;
                VerticalLayout {
                    padding: 9px;
                    spacing: 2px;
                    Text { text: "2. DECODER"; font-size: 9px; font-weight: 700; color: LunariaTheme.on-surface-variant; }
                    Text { text: root.signal-decoder; font-size: 10px; font-weight: 600; color: LunariaTheme.on-surface; wrap: word-wrap; }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: LunariaTheme.surface-container-low;
                border-width: 1px;
                border-color: LunariaTheme.outline-variant;
                VerticalLayout {
                    padding: 9px;
                    spacing: 3px;
                    Text { text: "3. PROCESSING CHAIN"; font-size: 9px; font-weight: 700; color: LunariaTheme.on-surface-variant; }
                    Text { text: root.signal-stage-1; font-size: 10px; color: LunariaTheme.on-surface; wrap: word-wrap; }
                    if root.signal-stage-2 != "": Text { text: root.signal-stage-2; font-size: 10px; color: LunariaTheme.on-surface-variant; wrap: word-wrap; }
                    if root.signal-stage-3 != "": Text { text: root.signal-stage-3; font-size: 9px; color: LunariaTheme.primary; wrap: word-wrap; }
                }
            }

            Rectangle {
                border-radius: 10px;
                background: LunariaTheme.surface-container-low;
                border-width: 1px;
                border-color: LunariaTheme.outline-variant;
                VerticalLayout {
                    padding: 9px;
                    spacing: 2px;
                    Text { text: "4. OUTPUT ENDPOINT"; font-size: 9px; font-weight: 700; color: LunariaTheme.on-surface-variant; }
                    Text { text: root.signal-device; font-size: 10px; font-weight: 700; color: LunariaTheme.on-surface; wrap: word-wrap; }
                    Text { text: root.signal-output-spec; font-size: 9px; font-weight: 600; color: LunariaTheme.primary; wrap: word-wrap; }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
