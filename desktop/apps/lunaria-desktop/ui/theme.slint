// Material 3 dynamic palette global updated from Rust via mcu-material-color (SchemeTonalSpot).

export global LunariaTheme {
    in-out property <bool> is-dark: true;

    in-out property <color> primary: #9AB0FF;
    in-out property <color> on-primary: #0F1D5C;
    in-out property <color> primary-container: #32428A;
    in-out property <color> on-primary-container: #F4F6FC;

    in-out property <color> secondary: #BDC4E0;
    in-out property <color> on-secondary: #272E47;
    in-out property <color> secondary-container: #3D4561;
    in-out property <color> on-secondary-container: #DDE2F7;

    in-out property <color> tertiary: #CEBCE6;

    in-out property <color> surface: #0D101B;
    in-out property <color> surface-container-lowest: #080A12;
    in-out property <color> surface-container-low: #101422;
    in-out property <color> surface-container: #141827;
    in-out property <color> surface-container-high: #1C2236;
    in-out property <color> surface-container-highest: #252C45;

    in-out property <color> on-surface: #F4F6FC;
    in-out property <color> on-surface-variant: #B8C0D9;
    in-out property <color> error: #FFB4AB;
    in-out property <color> on-error: #690005;
    in-out property <color> error-container: #93000A;
    in-out property <color> on-error-container: #FFDAD6;
    in-out property <color> outline: #6D789C;
    in-out property <color> outline-variant: #29314A;
}

export global MarqueeClock {
    in-out property <float> elapsed-sec: 0.0;
    in-out property <bool> active: false;
}
